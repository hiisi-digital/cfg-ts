{
  "name": "@hiisi/cfg-ts",
  "version": "0.1.1",
  "description": "The @cfg decorator for Rust-like conditional compilation in TypeScript, with a compiler transformer and language service plugin.",
  "license": "MPL-2.0",
  "exports": {
    ".": "./mod.ts",
    "./plugin": "./src/plugin/mod.ts",
    "./transform": "./src/transform/mod.ts",
    "./predicates": "./src/predicates/mod.ts",
    "./parse": "./src/parse.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@hiisi/ft-flags": "jsr:@hiisi/ft-flags@^0.1.2",
    "@hiisi/tgts": "jsr:@hiisi/tgts@^0.2.0",
    "typescript": "npm:typescript@^5.9.2",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "lint": {
    "include": [
      "**/*.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-await-in-loop",
        "no-console",
        "no-const-assign",
        "no-eval",
        "no-implicit-declare-namespace-export",
        "no-non-null-asserted-optional-chain",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "prefer-ascii",
        "single-var-declarator",
        "verbatim-module-syntax"
      ],
      "exclude": [
        "no-console"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "**/*.ts",
      "*.md"
    ]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net",
    "test:watch": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net --watch",
    "lint": "deno run -A --min-dep-age=0 jsr:@hiisi/viola-cli@^0.3.1 --project . --include .",
    "lint:fix": "deno lint --fix",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check mod.ts src/plugin/mod.ts src/predicates/mod.ts src/transform/mod.ts src/parse.ts",
    "all": "deno task fmt && deno task lint && deno task check && deno task test",
    "prepublish": "deno task all"
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests/",
      "examples/",
      "scripts/",
      ".githooks/"
    ]
  },
  "links": [
    "../tgts",
    "../ft-flags"
  ],
  "minimumDependencyAge": 0
}
